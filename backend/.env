# ============================================
# Environment Variables for Auth Backend
# ============================================

# Secret key used to sign and verify JWT tokens
# In production, use a long, random, unguessable string
JWT_SECRET=my_super_secret_jwt_key_change_in_production_2024

# Token expiration time (e.g., 1h = 1 hour, 7d = 7 days)
JWT_EXPIRES_IN=1h

# Port the server will listen on
PORT=3000
